---
permalink: /news/feed.xml
layout: null
sitemap: false
---
{%- assign items = site.data.news | sort: "date" | reverse -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title }} — News</title>
  <subtitle>News and updates from the {{ site.title }} lab at the {{ site.university }}.</subtitle>
  <link href="{{ '/news/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/news/' | absolute_url }}" rel="alternate" type="text/html"/>
  <id>{{ '/news/' | absolute_url }}</id>
  <updated>{{ items.first.date | date_to_xmlschema }}</updated>
  <author><name>{{ site.title }}</name></author>
  {%- for n in items %}
  {%- assign slug = n.date | date: "%Y-%m-%d" %}
  <entry>
    <title>{{ n.text | strip_html | truncate: 120 | escape }}</title>
    <link href="{{ '/news/' | absolute_url }}#{{ slug }}" rel="alternate" type="text/html"/>
    <id>{{ '/news/' | absolute_url }}#{{ slug }}</id>
    <updated>{{ n.date | date_to_xmlschema }}</updated>
    <published>{{ n.date | date_to_xmlschema }}</published>
    <content type="html">{{ n.text | escape }}</content>
  </entry>
  {%- endfor %}
</feed>
